# Haystax — backend environment template
# Copy this file to .env and fill in real values.
# DO NOT commit the real .env file — it's gitignored.

# Database — hosted Supabase (session pooler, port 5432)
HAYSTAX_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
HAYSTAX_DB_USER=postgres.<your-project-ref>
HAYSTAX_DB_PASSWORD=<your-supabase-database-password>

# JWT — stub until Member 2 ships the real JwtService
HAYSTAX_JWT_SECRET=dev-only-secret-change-in-production
HAYSTAX_JWT_ISSUER=haystax

# Runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# CORS — allowed frontend origins (comma-separated)
HAYSTAX_CORS_ORIGINS=http://localhost:4200
