 
#  Haystax — .gitignore
#  Monorepo: Angular 21 + Spring Boot 4 + Supabase + Docker
 
 
#  🔐  SECRETS — NEVER COMMIT
 
.env
.env.*
!.env.example

# Backend secrets (real config — use application.properties.example instead)
backend/src/main/resources/application.properties
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-dev.properties
backend/src/main/resources/application-prod.properties
backend/src/main/resources/application-*-secret.properties

# Frontend secrets
frontend/src/environments/environment.local.ts
frontend/src/environments/environment.*.local.ts
frontend/.env
frontend/.env.*

# Supabase / DB dumps
*.dump
*.sql.gz
*.backup

 
#  🟢  ANGULAR / NODE
 
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out-tsc/
bazel-out/

# Angular
.angular/
.angular/cache/
frontend/.angular/
frontend/dist/
frontend/coverage/
coverage/
*.tsbuildinfo

# Vite (used internally by Angular 17+)
.vite/
frontend/.vite/

# Package manager lockfiles — keep yarn.lock OR package-lock.json, not both
# (Uncomment the one you don't use)
# yarn.lock
# package-lock.json
# pnpm-lock.yaml

 
#  ☕  SPRING BOOT / JAVA / MAVEN
 
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Compiled class files
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Maven
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# Gradle (in case you switch)
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

 
#  🐳  DOCKER
 
# Docker volumes and runtime
docker-compose.override.yml
.docker/
*.pid

# If you have a local data folder mounted by Compose
infra/data/
infra/volumes/

 
#  🗄️  SUPABASE (local CLI)
 
supabase/.temp/
supabase/.branches/
supabase/.env
.branches/
.temp/

# Local Supabase config that might contain secrets
# (config.toml itself IS committed — it's the project config)
supabase/config.local.toml

 
#  📋  LOGS & RUNTIME
 
.logs/
*.log
logs/
*.log.*

# Our startup script logs
.logs/backend.log
.logs/frontend.log

 
#  🧪  TESTS & COVERAGE
 
coverage/
.nyc_output/
junit/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
frontend/cypress/videos/
frontend/cypress/screenshots/

 
#  💻  IDE / EDITORS
 
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# IntelliJ IDEA / WebStorm / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse / STS
.apt_generated/
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Vim / Emacs
*.swp
*.swo
*~
.\#*
\#*\#
.\#*

 
#  🖥️  OS-SPECIFIC
 
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*
 
#  🚫  MISC 
*.bak
*.orig
*.tmp
*.temp
.cache/
tmp/
temp/

# Shell scripts for managing local services
stop-all.sh
start-all.sh
